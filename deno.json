{
  "name": "@ikuradon/tsunagiya",
  "version": "0.3.0",
  "description": "Nostr relay mock library for testing. Intercepts WebSocket to test existing Nostr clients without code changes. Supports NIP-01, NIP-42, unstable relay simulation, and test helpers.",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./testing": "./src/testing/mod.ts"
  },
  "tasks": {
    "test": "deno test --ignore=examples tests/",
    "test:all": "deno test -A tests/ examples/",
    "example": "deno test -A examples/",
    "example:basic": "deno test -A examples/basic/",
    "example:nostr-tools": "deno test -A examples/nostr-tools/",
    "example:ndk": "deno test -A examples/ndk/",
    "example:rx-nostr": "deno test -A examples/rx-nostr/",
    "example:nostr-fetch": "deno test -A examples/nostr-fetch/",
    "run:basic": "deno run --allow-net examples/basic/client.ts",
    "run:nostr-tools": "deno run -A examples/nostr-tools/client.ts",
    "run:ndk": "deno run -A examples/ndk/client.ts",
    "run:rx-nostr": "deno run -A examples/rx-nostr/client.ts",
    "run:nostr-fetch": "deno run -A examples/nostr-fetch/client.ts",
    "coverage": "deno test --coverage=./coverage tests/",
    "coverage:report": "deno coverage ./coverage --lcov",
    "check": "deno check src/mod.ts src/testing/mod.ts && deno lint && deno fmt --check",
    "fmt": "deno fmt",
    "docs:dev": "cd docs && deno task dev",
    "docs:build": "cd docs && deno task build",
    "docs:preview": "cd docs && deno task preview"
  },
  "compilerOptions": {
    "strict": true
  },
  "publish": {
    "include": ["src/", "README.md", "LICENSE", "deno.json"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "nostr-tools/pure": "npm:nostr-tools@^2/pure",
    "nostr-tools/pool": "npm:nostr-tools@^2/pool",
    "nostr-tools/nip11": "npm:nostr-tools@^2/nip11",
    "@nostr-dev-kit/ndk": "npm:@nostr-dev-kit/ndk@^2",
    "rx-nostr": "npm:rx-nostr@^3",
    "@rx-nostr/crypto": "npm:@rx-nostr/crypto@0",
    "nostr-fetch": "npm:nostr-fetch@^0"
  }
}
